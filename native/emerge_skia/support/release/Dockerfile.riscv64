FROM ubuntu:24.04
# Restrict the host mirror to amd64; RISC-V packages live on ports.ubuntu.com.
RUN sed -i '/^Types:/a Architectures: amd64' /etc/apt/sources.list.d/ubuntu.sources && \
    printf '%s\n' 'Types: deb' 'URIs: http://ports.ubuntu.com/ubuntu-ports' \
      'Suites: noble noble-updates noble-security' 'Components: main universe' \
      'Architectures: riscv64' 'Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg' \
      > /etc/apt/sources.list.d/riscv64.sources && \
    dpkg --add-architecture riscv64 && apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --assume-yes --no-install-recommends \
      ca-certificates curl git clang g++ python3 ninja-build pkg-config qemu-user \
      gcc-riscv64-linux-gnu g++-riscv64-linux-gnu binutils-riscv64-linux-gnu \
      libegl1-mesa-dev:riscv64 libgbm-dev:riscv64 libdrm-dev:riscv64 && \
    rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- \
    -y --profile minimal --default-toolchain 1.91.0 --target riscv64gc-unknown-linux-gnu
ENV CARGO_TARGET_RISCV64GC_UNKNOWN_LINUX_GNU_LINKER=riscv64-linux-gnu-gcc \
    CC="clang --target=riscv64-unknown-linux-gnu --sysroot=/usr/riscv64-linux-gnu" \
    CXX="clang++ --target=riscv64-unknown-linux-gnu --sysroot=/usr/riscv64-linux-gnu" \
    HOST_CC=gcc HOST_CXX=g++ \
    SDKTARGETSYSROOT=/usr/riscv64-linux-gnu \
    PKG_CONFIG_ALLOW_CROSS=1 \
    PKG_CONFIG_LIBDIR=/usr/lib/riscv64-linux-gnu/pkgconfig:/usr/share/pkgconfig
WORKDIR /source/native/emerge_skia
ENTRYPOINT ["bash", "support/release/build.sh"]
