+//! Native-only authority for focused text publication. Neither a BEAM echo token
+//! nor a renderer-install/presentation acknowledgment.
+use std::sync::Arc;
+
+use crate::{events::TextInputState, tree::element::NodeId};
+
+#[derive(Debug)]
+struct Binding {
