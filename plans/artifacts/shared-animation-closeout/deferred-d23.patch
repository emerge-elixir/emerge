+            }
+        }
+        fn send_element_event(
+            &self,
+            _: &NodeId,
+            _: ElementEventKind,
+            _: Option<&registry_builder::ElixirEventPayload>,
+        ) {
+        }
+    }
+    let assets = crate::assets::AssetRuntime::new();
+    let _assets = assets.enter();
+    let (mut engine, host) = ready();
+    let HostEventRuntime {
+        mut driver,
+        tree_rx: old_rx,
+    } = host;
+    drop(old_rx);
+    let (tree_tx, tree_rx) = bounded(1);
+    let (event_tx, event_rx) = bounded(2048);
+    let (seen_tx, seen_rx) = bounded(1);
+    driver.tree_tx = tree_tx;
+    driver.runtime.host_event_sink = Some(Arc::new(Seen(seen_tx)));
