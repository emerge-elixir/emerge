+#[test]
+fn held_tree_does_not_block_native_edits_and_publishes_only_the_latest_tail() {
+    let assets = crate::assets::AssetRuntime::new();
+    let _assets = assets.enter();
+    let (mut engine, mut host) = ready();
+    let recorder = Arc::new(pointer::Recorder::default());
+    host.driver.runtime.host_event_sink = Some(recorder.clone());
+    commit(&mut host, "X");
+    let first = host.drain_tree_messages();
+    assert_eq!(first.len(), 1);
+    assert_eq!(update(&first[0]).publication.version, 1);
+    for _ in 0..1000 {
+        commit(&mut host, "Y");
+    }
+    assert_eq!(
+        host.focused_text_state().unwrap().content,
+        format!("abcX{}", "Y".repeat(1000))
+    );
+    assert!(host.driver.runtime.listener_lane.buffered_inputs.is_empty());
+    assert!(host.driver.runtime.pending_text_patches.is_empty());
+    assert!(
+        host.drain_tree_messages().is_empty(),
+        "no packet per locally accepted edit"
+    );
+    let first_reply = response(&mut engine, first, TreeUpdateDecodePolicy::ReturnErr);
+    host.install_rebuild(first_reply.clone());
+    let latest = host.drain_tree_messages();
+    assert_eq!(latest.len(), 1);
+    assert_eq!(update(&latest[0]).publication.version, 2);
+    assert_eq!(
+        update(&latest[0]).content,
+        host.focused_text_state().unwrap().content
+    );
+    host.install_rebuild(first_reply);
+    assert!(
+        host.driver.awaiting_registry.is_some(),
+        "old reply cannot cover latest state"
+    );
+    host.install_rebuild(response(
+        &mut engine,
+        latest,
+        TreeUpdateDecodePolicy::ReturnErr,
+    ));
+    assert_eq!(settle(&mut engine, &mut host), 0);
+    assert_eq!(recorder.raw.lock().unwrap().len(), 1001);
+    assert!(
+        recorder.events.lock().unwrap().is_empty(),
+        "this input has no callback binding"
+    );
+}
