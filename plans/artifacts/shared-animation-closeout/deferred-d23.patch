+#[test]
+fn authoritative_reset_rejects_old_scope_but_geometry_only_patch_preserves_it() {
+    let assets = crate::assets::AssetRuntime::new();
+    let _assets = assets.enter();
+    for reset in [None, Some("reset")] {
+        for patch_first in [false, true] {
+            let (mut engine, mut host) = ready();
+            commit(&mut host, "X");
+            commit(&mut host, "Y");
+            let first = host.drain_tree_messages();
+            let original = update(&first[0]).publication.scope.clone();
+            let messages = if patch_first {
+                std::iter::once(attrs_patch(reset)).chain(first).collect()
+            } else {
+                first.into_iter().chain([attrs_patch(reset)]).collect()
+            };
+            host.install_rebuild(response(
+                &mut engine,
+                messages,
+                TreeUpdateDecodePolicy::ReturnErr,
+            ));
+            settle(&mut engine, &mut host);
+            if reset.is_some() {
+                assert_eq!(host.focused_text_state().unwrap().content, "reset");
+                assert!(
+                    host.driver
+                        .native_edit
+                        .as_ref()
+                        .is_none_or(|current| !current.scope.matches(&original))
+                );
+            } else {
+                assert_eq!(host.focused_text_state().unwrap().content, "abcXY");
+                assert!(
+                    host.driver
+                        .native_edit
+                        .as_ref()
+                        .unwrap()
+                        .scope
+                        .matches(&original)
+                );
+            }
+        }
+    }
+}
