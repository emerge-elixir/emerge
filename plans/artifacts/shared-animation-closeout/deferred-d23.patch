+fn attrs_patch(content: Option<&str>) -> TreeMsg {
+    let attrs: Vec<u8> = (2u16 + u16::from(content.is_some()))
+        .to_be_bytes()
+        .into_iter()
+        .chain([1, 0, 2, 2])
+        .chain(30f64.to_be_bytes())
+        .chain(content.into_iter().flat_map(|text| {
+            std::iter::once(21)
+                .chain((text.len() as u16).to_be_bytes())
+                .chain(text.bytes())
+        }))
+        .collect();
+    TreeMsg::PatchTree {
+        bytes: std::iter::once(1)
+            .chain(9u64.to_be_bytes())
+            .chain((attrs.len() as u32).to_be_bytes())
+            .chain(attrs)
+            .collect(),
+        submitted_at: None,
+    }
+}
